@page "/"
@rendermode InteractiveServer
@using BlazorDemo.Models
@using BlazorDemo.Services
@using Microsoft.Extensions.Options
@inject IFileValidationService FileValidationService
@inject IFilePreviewService FilePreviewService
@inject IFileUploadService FileUploadService
@inject IOptions<UploadOptions> UploadOptionsAccessor

<PageTitle>Upload Demo App</PageTitle>

<div class="container mt-4">
    <h1 class="mb-4">Upload Demo App</h1>

    <EditForm Model="customerModel" OnValidSubmit="UploadFiles">
        <div>
            <label for="firstName">First Name:</label>
            <InputText id="firstName" class="form-control" @bind-Value="customerModel.FirstName" />
        </div>
        <div>
            <label for="lastName">Last Name:</label>
            <InputText id="lastName" class="form-control" @bind-Value="customerModel.LastName" />
        </div>
        <div>
            <label for="FileNames">File Names:</label>
            <div class="form-control">
                <!-- File Selection - Only show if less than max files -->
                @if (selectedFiles.Count < maxAllowedFiles)
                {
                    <div class="mb-3">
                        <InputFile OnChange="@OnInputFileChange" multiple />
                        <small class="text-muted">
                            Max file size: 3MB | Max files: @maxAllowedFiles 
                            (You can add @(maxAllowedFiles - selectedFiles.Count) more)
                        </small>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-3">
                        <i class="fas fa-info-circle me-2"></i>
                        Maximum @maxAllowedFiles files selected. Remove some to add more.
                    </div>
                }

                <!-- File Previews -->
                @if (selectedFiles.Any())
                {
                    <div class="mt-8 mb-4">
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                            <h5 class="mb-0">Selected Files (@selectedFiles.Count / @maxAllowedFiles)</h5>
                            <button class="btn btn-sm btn-outline-danger" @onclick="ClearAllFiles">
                                <i class="fas fa-trash me-1"></i> Clear All
                            </button>
                        </div>
                        <div class="row">
                            @foreach (var file in selectedFiles)
                            {
                                <div class="col-md-4 mb-3">
                                    <div class="border rounded p-2 position-relative">
                                        <!-- Remove button -->
                                        <button class="btn btn-sm btn-outline-danger position-absolute top-0 end-0 m-1 px-2 py-0" 
                                                @onclick="() => RemoveFile(file)"
                                                style="z-index: 10;">
                                            <i class="fas fa-times"></i>
                                        </button>
                                        
                                        <!-- File preview -->
                                        <div class="text-center mb-2">
                                            @if (IsImageFile(file.Name))
                                            {
                                                <img src="@file.PreviewUrl" class="img-fluid" style="max-height: 100px;" alt="@file.Name" />
                                            }
                                            else
                                            {
                                                <i class="fas fa-file-alt fa-3x text-secondary"></i>
                                            }
                                        </div>
                                        <div class="small text-truncate" title="@file.Name">@file.Name</div>
                                        <div class="small text-muted">@FormatFileSize(file.Size)</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
        <!-- Upload Button -->
        <button class="btn btn-primary mt-3" type="submit" disabled="@(!selectedFiles.Any() || isUploading)">
            @if (isUploading)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>
            }
            <i class="fas fa-upload me-2"></i>
            Upload Files
        </button>
    </EditForm>

    <!-- Errors -->
    @if (errors.Any())
    {
        <div class="alert alert-danger mt-4">
            <h6>Errors:</h6>
            <ul class="mb-0">
                @foreach (var error in errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <!-- Success -->
    @if (successCount > 0)
    {
        <div class="alert alert-success mt-4">
            <i class="fas fa-check-circle me-2"></i>
            Successfully uploaded @successCount file(s).
        </div>
    }
</div>

@code {
    private CustomerModel customerModel = new();
    private List<FilePreview> selectedFiles = new();
    private List<string> selectedFileNames = new(); // Simulate existing files for duplicate check
    private List<string> errors = new();
    private int successCount = 0;
    private bool isUploading = false;

    // Values loaded from appsettings.json via IOptions<UploadOptions>
    private long maxFileSize => UploadOptionsAccessor.Value.MaxFileSize;
    private int maxAllowedFiles => UploadOptionsAccessor.Value.MaxFileCount;

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        errors.Clear();

        var newFiles = e.GetMultipleFiles();
        
        // Check if adding new files would exceed the limit
        if (selectedFiles.Count + newFiles.Count > maxAllowedFiles)
        {
            errors.Add($"Error: You can only have a maximum of {maxAllowedFiles} files. You currently have {selectedFiles.Count} and tried to add {newFiles.Count}.");
            return;
        }

        foreach (var file in newFiles)
        {
            // Check if file already exists in selection
            if (selectedFiles.Any(f => f.Name == file.Name && f.Size == file.Size))
            {
                errors.Add($"Error: File '{file.Name}' is already selected.");
                continue;
            }

            if (!FileValidationService.IsWithinSizeLimit(file.Size, maxFileSize))
            {
                errors.Add($"Error: File '{file.Name}' exceeds 3MB limit.");
                continue;
            }

            // Create preview using service
            var previewDto = await FilePreviewService.CreatePreviewAsync(file, maxFileSize);

            selectedFiles.Add(new FilePreview
            {
                Name = previewDto.Name,
                Size = previewDto.Size,
                ContentType = previewDto.ContentType,
                PreviewUrl = previewDto.PreviewUrl,
                FileData = previewDto.FileData
            });
        }
    }

    private void RemoveFile(FilePreview file)
    {
        selectedFiles.Remove(file);
    }

    private void ClearAllFiles()
    {
        selectedFiles.Clear();
    }

    private async Task UploadFiles()
    {
        if (!selectedFiles.Any()) return;

        isUploading = true;
        errors.Clear();
        successCount = 0;
        selectedFileNames = [];

        foreach (var file in selectedFiles)
        {
            var result = await FileUploadService.SaveFileAsync(file.FileData!, maxFileSize);

            if (result.Success)
            {
                successCount++;
                selectedFileNames.Add(result.StoredPath!);
            }
            else
            {
                errors.Add(result.ErrorMessage!);
            }
        }

        if (errors.Count == 0)
        {
            selectedFiles.Clear(); // Clear all files after successful upload
            customerModel.FileNames = selectedFileNames; // Simulate saving file paths to model
        }

        isUploading = false;
    }

    private bool IsImageFile(string fileName) => FileValidationService.IsImageFile(fileName);

    private string FormatFileSize(long bytes) => FileValidationService.FormatFileSize(bytes);

    private class FilePreview
    {
        public string? Name { get; set; }
        public long Size { get; set; }
        public string? ContentType { get; set; }
        public string? PreviewUrl { get; set; }
        public IBrowserFile? FileData { get; set; }
    }
}